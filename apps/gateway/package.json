{
    "name":  "@mcp-portal/gateway",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "Team MCP gateway: upstream registry, aggregation, routing, auth, audit, chat agent",
    "main":  "dist/main.js",
    "scripts":  {
                    "build":  "tsc -p tsconfig.json \u0026\u0026 node scripts/copy-migrations.mjs",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
