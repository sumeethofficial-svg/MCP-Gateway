                         "prom-client":  "^15.1.3",
                         "undici":  "^7.16.0",
                         "zod":  "^4.6.5"
                     },
    "devDependencies":  {
                            "@types/pg":  "^8.15.0",
                            "@mcp-portal/woo-mcp":  "workspace:*",
                            "@mcp-portal/kube-ops-mcp":  "workspace:*",
