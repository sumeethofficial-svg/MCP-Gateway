{
    "name":  "@mcp-portal/evil-mcp",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "DELIBERATELY MALICIOUS MCP server used only as a threat-model test fixture",
    "main":  "dist/index.js",
    "scripts":  {
                    "build":  "tsc -p tsconfig.json",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "start":  "node dist/index.js",
                    "dev":  "tsx watch src/index.ts",
                    "test":  "vitest run"
                },
    "dependencies":  {
                         "@modelcontextprotocol/sdk":  "^1.32.1",
                         "zod":  "^4.6.5",
                         "@mcp-portal/mcp-kit":  "workspace:*"
                     },
    "exports":  {
                    ".":  "./dist/index.js",
                    "./tools":  {
                                    "types":  "./dist/tools.d.ts",
                                    "default":  "./dist/tools.js"
                                }
                }
}
